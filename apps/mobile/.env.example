# Copied to apps/mobile/.env for local development. Never commit real secrets.
#
# Base URL of the PRIME API as reachable FROM THE PHONE:
#   - Android emulator : http://10.0.2.2:3000/api
#   - Physical phone   : http://<your-computer-LAN-IP>:3000/api  (same Wi-Fi)
#   - Production       : https://api.prime.itgel.com/api
#
# Leave unset to use the default http://localhost:3000/api (works when the app
# runs on the same machine as the API, e.g. web or a local emulator that maps
# host localhost).
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
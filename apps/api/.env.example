# Copied to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000

# Prisma v7 reads DATABASE_URL from the environment automatically - no url in
# schema.prisma. Point at PgBouncer (transaction mode) exposed on host port
# 6432, connecting as the NOBYPASSRLS app role (prime_app): if you connect as
# the schema owner/superuser instead, RLS policies are bypassed (design 7.6).
DATABASE_URL=postgresql://prime_app:prime_app_password@localhost:6432/prime_db

# Optional admin URL (schema owner) for `prisma migrate deploy`.
ADMIN_DATABASE_URL=postgresql://prime_user:prime_password@localhost:6432/prime_db

JWT_SECRET=change_me_to_a_random_string_of_at_least_64_characters_aaaaa
JWT_REFRESH_SECRET=change_me_to_a_different_random_string_of_at_least_64_bbbbb
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

QWEN_API_URL=https://api-inference.huggingface.co/models/Qwen/Qwen2.5-VL-7B-Instruct
QWEN_API_KEY=

EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest
EXCHANGE_RATE_API_KEY=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AI_RATE_LIMIT_PER_HOUR=30
MAX_AI_AMOUNT_NGN=10000000

EMAIL_FROM=noreply@prime.itgel.com
EMAIL_API_KEY=

CORS_ORIGINS=http://localhost:8081
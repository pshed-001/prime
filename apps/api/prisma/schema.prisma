generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // No url field here. Prisma v7 reads DATABASE_URL from the environment
  // automatically. See apps/api/.env and prisma.config.ts.
}

// ---------------------------------------------------------------------------
// RULE DB-01: every create call provides id = uuidv7() explicitly at the
// service layer. @default(uuid()) below is a safety net only and generates
// UUIDv4 - it must never be relied upon.
// RULE DB-04: all monetary values are Decimal. Never Float.
// ---------------------------------------------------------------------------

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  emailVerified  Boolean  @default(false)
  passwordHash   String
  deviceId       String?
  failedAttempts Int      @default(0)
  lockedUntil    DateTime?
  mfaSecret      String?
  mfaEnabled     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  settings       UserSettings?
  tasks          Task[]
  expenses       Expense[]
  assets         Asset[]
  reports        Report[]
  syncQueue      SyncQueue[]
  auditLogs      AuditLog[]
  exchangeRates  ExchangeRateSnapshot[]
  passwordResets PasswordResetToken[]
  refreshTokens  RefreshToken[]

  @@map("users")
}

model UserSettings {
  id             String    @id @default(uuid())
  userId         String    @unique
  timezone       String    @default("Africa/Lagos")
  baseCurrency   String    @default("NGN")
  dailyBudget    Decimal?  @db.Decimal(12, 2)
  aiConsentGiven Boolean   @default(false)
  theme          String    @default("system")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  purpose   String    @default("PASSWORD_RESET")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id            String    @id @default(uuid())
  userId        String
  tokenFamilyId String
  tokenHash     String    @unique
  consumed      Boolean   @default(false)
  consumedAt    DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamilyId])
  @@map("refresh_tokens")
}

model Task {
  id          String     @id @default(uuid())
  userId      String
  title       String
  description String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(PENDING)
  dueDate     DateTime?
  version     Int        @default(1)
  source      Source     @default(MANUAL)
  deletedAt   DateTime?
  syncedAt    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, deletedAt])
  @@map("tasks")
}

model Expense {
  id             String          @id @default(uuid())
  userId         String
  amount         Decimal         @db.Decimal(12, 2)
  currency       String          @default("NGN")
  amountBase     Decimal         @db.Decimal(12, 2)
  exchangeRate   Decimal?        @db.Decimal(18, 6)
  rateIsEstimate Boolean         @default(false)
  type           TransactionType
  category       String
  note           String?
  date           DateTime        @default(now())
  version        Int             @default(1)
  source         Source          @default(MANUAL)
  deletedAt      DateTime?
  syncedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@index([userId, deletedAt])
  @@map("expenses")
}

model Asset {
  id             String        @id @default(uuid())
  userId         String
  name           String
  category       AssetCategory
  value          Decimal       @db.Decimal(12, 2)
  currency       String        @default("NGN")
  valueBase      Decimal       @db.Decimal(12, 2)
  exchangeRate   Decimal?      @db.Decimal(18, 6)
  rateIsEstimate Boolean       @default(false)
  note           String?
  acquiredAt     DateTime?
  version        Int           @default(1)
  source         Source        @default(MANUAL)
  deletedAt      DateTime?
  syncedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, deletedAt])
  @@map("assets")
}

model Report {
  id           String   @id @default(uuid())
  userId       String
  date         DateTime
  baseCurrency String
  totalIncome  Decimal  @db.Decimal(12, 2)
  totalExpense Decimal  @db.Decimal(12, 2)
  netBalance   Decimal  @db.Decimal(12, 2)
  pdfUrl       String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("reports")
}

model SyncQueue {
  id             String    @id @default(uuid())
  userId         String
  idempotencyKey String    @unique
  operation      SyncOp
  tableName      String
  recordId       String
  payload        Json
  clientVersion  Int
  synced         Boolean   @default(false)
  retries        Int       @default(0)
  deadLettered   Boolean   @default(false)
  lastError      String?
  createdAt      DateTime  @default(now())
  syncedAt       DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, synced, deadLettered])
  @@map("sync_queue")
}

model AuditLog {
  id             String   @id @default(uuid())
  userId         String
  tableName      String
  recordId       String
  operation      SyncOp
  changedFields  Json
  previousValues Json?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, tableName])
  @@map("audit_logs")
}

model ExchangeRateSnapshot {
  id           String   @id @default(uuid())
  userId       String
  fromCurrency String
  toCurrency   String
  rate         Decimal  @db.Decimal(18, 6)
  source       String
  fetchedAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, fromCurrency, toCurrency])
  @@map("exchange_rate_snapshots")
}

model Tombstone {
  id        String   @id @default(uuid())
  userId    String
  tableName String
  recordId  String
  deletedAt DateTime @default(now())

  @@unique([userId, tableName, recordId])
  @@index([userId, deletedAt])
  @@map("tombstones")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AssetCategory {
  DEVICE
  VEHICLE
  PROPERTY
  BANK_ACCOUNT
  INVESTMENT
  OTHER
}

enum SyncOp {
  CREATE
  UPDATE
  DELETE
}

enum Source {
  MANUAL
  AI
  IMPORTED
}
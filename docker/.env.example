# Docker Compose environment - copy to .env and edit
POSTGRES_USER=prime_user
POSTGRES_PASSWORD=prime_password
POSTGRES_APP_PASSWORD=prime_app_password
POSTGRES_DB=prime_db
POSTGRES_HOST_PORT=5432

PGADMIN_EMAIL=admin@prime.itgel.com
PGADMIN_PASSWORD=prime_admin_password
API_HOST_PORT=3000

NODE_ENV=development
JWT_SECRET=change_me_64_characters_or_more_compose_secret_aaaaaaaaaaaaaaa
JWT_REFRESH_SECRET=change_me_different_64_characters_or_more_compose_secret_bbbb

# Comma-separated IPs/CIDRs allowed to set X-Forwarded-For (e.g. the reverse
# proxy in front of the API). Leave empty when the API is reached directly -
# then spoofed X-Forwarded-For headers are ignored and rate limits key on the
# real socket IP. IPv4 and IPv6 CIDRs are supported (e.g. 10.10.0.0/24, 172.16.5.7).
TRUST_PROXY_IPS=
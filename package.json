{
  "name": "prime",
  "version": "1.0.0",
  "private": true,
  "description": "PRIME - Personal Finance and Productivity Platform (ITGEL)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w api",
    "dev:mobile": "npm run start -w mobile",
    "build": "npm run build -w @prime/shared",
    "seed": "npm run seed -w api",
    "migrate": "npm run migrate -w api",
    "generate": "npm run generate -w api",
    "audit": "npm audit"
  }
}